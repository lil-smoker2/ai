# Frontend dev settings. Copy to .env if you need to override.
# Leave VITE_API_BASE_URL unset for normal dev: the Vite proxy forwards /api to
# http://localhost:8000. Set it only to point the UI at a remote/other API, e.g.
# VITE_API_BASE_URL=https://api.example.com   (the packaged app always uses same-origin)
VITE_API_BASE_URL=
# OAuth Web client ID from Google Cloud Console. Leave unset to hide
# "Sign in with Google". Must match GOOGLE_CLIENT_ID on the API.
VITE_GOOGLE_CLIENT_ID=
