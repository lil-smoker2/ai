# LifeSmart environment example. Copy to .env and adjust.
# NEVER commit real secrets.

# --- Backend (apps/api) ---
# Database URL. Dev default is SQLite; switch to PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/lifesmart
DATABASE_URL=sqlite:///./lifesmart.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-byte-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Root directory scanned by the asset pipeline (relative to repo root or absolute)
ASSETS_ROOT=assets
# Max accepted image file size in bytes (20 MB)
MAX_IMAGE_BYTES=20000000
# Comma-separated supported image formats (validated by file content, not extension)
SUPPORTED_IMAGE_FORMATS=JPEG,PNG,WEBP

# CORS origin for the dev frontend
FRONTEND_ORIGIN=http://localhost:5173

# Single-user local mode: autofill a local account and JWT so the app opens
# without a login screen for a personal device. Set to false for hosted/shared
# deployments requiring real auth.
LOCAL_SINGLE_USER=true

# Optional local model for the AI assistant (a Qwen *.gguf via llama.cpp).
# This only OFFERS the model on the AI page; it is never loaded at startup -
# press "Load" there to put it into memory (and "Unload" to free it again).
# Requires llama-cpp-python (see apps/api/requirements-build.txt); without it
# the assistant keeps using its deterministic keyword router.
ASSISTANT_LLM_ENABLED=false
# Look for a *.gguf here first (relative to repo root, or absolute). Empty =
# fall back to the models/ and "ai model/" folders.
ASSISTANT_MODEL_PATH=
# Inference knobs: CPU threads and context window.
ASSISTANT_LLM_THREADS=2
ASSISTANT_LLM_CTX=2048

# Optional: "Sign in with Google". OAuth Web client ID from Google Cloud Console.
# Leave empty to disable. Add http://localhost:5173 (and http://localhost:8756 for
# the desktop app) as an Authorized JavaScript origin in the Google console.
GOOGLE_CLIENT_ID=

# --- Frontend (apps/web) ---
VITE_API_BASE_URL=http://localhost:8000
# Must match GOOGLE_CLIENT_ID above for the sign-in button to appear.
VITE_GOOGLE_CLIENT_ID=
